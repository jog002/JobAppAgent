# =============================================================================
# JOB AGENT CONFIGURATION
# =============================================================================
# Copy to .env and fill in your values: cp .env.example .env

# =============================================================================
# LLM PROVIDER (required)
# =============================================================================
LLM_PROVIDER=claude                    # claude | openai

# Claude API - https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514  # claude-sonnet-4-20250514 | claude-3-5-haiku-20241022
CLAUDE_TEMPERATURE=0.3                 # 0.0-1.0
CLAUDE_MAX_TOKENS=1000                 # max response tokens
CLAUDE_INPUT_COST_PER_M=3.0            # cost tracking
CLAUDE_OUTPUT_COST_PER_M=15.0          # cost tracking

# OpenAI API - https://platform.openai.com/api-keys (if using openai)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o                    # gpt-4o | gpt-4o-mini | gpt-4-turbo
OPENAI_TEMPERATURE=0.3                 # 0.0-2.0
OPENAI_MAX_TOKENS=2000                 # max response tokens
OPENAI_INPUT_COST_PER_M=2.0            # cost tracking
OPENAI_OUTPUT_COST_PER_M=8.0           # cost tracking

# =============================================================================
# JOB SEARCH
# =============================================================================
SEARCH_KEYWORDS=software engineer      # comma-separated keywords
SEARCH_LOCATIONS=Remote,New York       # comma-separated locations
MAX_RESULTS_PER_SEARCH=50              # max jobs per search
LOCATION_TERMS=NY,New York,Remote,NYC  # location aliases for filtering

# =============================================================================
# JOB SCORING
# =============================================================================
MIN_DISPLAY_SCORE=60                   # 0-100, minimum score to show
TOP_JOBS_LIMIT=20                      # max top jobs in report

# =============================================================================
# DISCOVERY PROVIDERS
# =============================================================================
ENABLED_SOURCES=web_scraping           # web_scraping (linkedin is legacy)
ENABLED_DISCOVERY_PROVIDERS=greenhouse_api,lever_api,ashby_api,serpapi,jobspy

# Direct API Polling (free, no rate limits)
GREENHOUSE_API_ENABLED=true            # true | false
LEVER_API_ENABLED=true                 # true | false
ASHBY_API_ENABLED=true                 # true | false

# JobSpy - aggregates from job boards
JOBSPY_SITES=indeed,google             # indeed | google | glassdoor | linkedin | zip_recruiter
JOBSPY_HOURS_OLD=72                    # only jobs from last N hours

# SerpAPI - https://serpapi.com/ (250 free/month)
# SERPAPI_API_KEY=your-key-here
SERPAPI_PAGES=3                        # pages per search (1 page = 10 results = 1 credit)
SERPAPI_RECENCY=day                    # hour | day | week | month | year | (empty)
SERPAPI_TARGET_SITE=greenhouse.io      # site to search

# Brave Search - https://brave.com/search/api/ (2000 free/month)
# BRAVE_API_KEY=your-key-here
BRAVE_SEARCH_FRESHNESS=day             # day | week | month | (empty)

# =============================================================================
# WEB SCRAPING
# =============================================================================
WEB_SCRAPING_PLATFORMS=greenhouse,lever,bamboohr,ashby
SCRAPING_DELAY_SECONDS=2.0             # delay between scrapes

# =============================================================================
# SEARCH MODE (for Google/Brave search queries)
# =============================================================================
SEARCH_MODE=combined                   # default | mid_level | exclude_senior | combined
LEVEL_TERMS=Software Engineer II,SWE II,SWE 2
# EXCLUDE_LEVELS=Senior,Staff,Principal,Lead

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_MODE=local                    # local | turso

# Local SQLite (when DATABASE_MODE=local)
DATABASE_PATH=./data/jobs.db

# Turso Cloud - https://turso.tech/ (when DATABASE_MODE=turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# =============================================================================
# EMAIL REPORTS (optional)
# =============================================================================
EMAIL_ENABLED=false                    # true | false
# EMAIL_RECIPIENT=you@example.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SENDER_EMAIL=you@example.com
# SMTP_SENDER_PASSWORD=app-password
# SMTP_USE_TLS=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/agent.log
