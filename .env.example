# Multi-Source Job Agent Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# REQUIRED: LLM API Configuration
# =============================================================================
# Choose your LLM provider: "claude" or "openai"
LLM_PROVIDER=claude

# Claude API (https://console.anthropic.com/)
CLAUDE_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_TEMPERATURE=0.3
CLAUDE_MAX_TOKENS=1000
CLAUDE_INPUT_COST_PER_M=3.0
CLAUDE_OUTPUT_COST_PER_M=15.0

# OpenAI API (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000
OPENAI_INPUT_COST_PER_M=2.0
OPENAI_OUTPUT_COST_PER_M=8.0

# =============================================================================
# OPTIONAL: LinkedIn MCP Server (choose ONE method)
# =============================================================================
# Method 1: Cookie-based authentication
# Get your li_at cookie from LinkedIn (F12 > Application > Cookies)
# LINKEDIN_COOKIE=your-li_at-cookie-here

# Method 2: Session file authentication (more reliable)
# Run: uvx --from linkedin-mcp-server linkedin-mcp-server --get-session
# LINKEDIN_SESSION_PATH=/Users/yourname/.linkedin-mcp/session.json

# =============================================================================
# OPTIONAL: Search API Keys
# =============================================================================
# Brave Search API (https://brave.com/search/api/) - Free: 2,000 queries/month
# BRAVE_API_KEY=your-brave-api-key-here
BRAVE_SEARCH_FRESHNESS=day

# SerpAPI for Google Search (https://serpapi.com/) - Free: 250 searches/month
# SERPAPI_API_KEY=your-serpapi-key-here
SERPAPI_PAGES=1
SERPAPI_RECENCY=day
SERPAPI_TARGET_SITE=greenhouse.io

# =============================================================================
# OPTIONAL: Email Reports
# =============================================================================
EMAIL_ENABLED=false
# EMAIL_RECIPIENT=your-email@example.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SENDER_EMAIL=your-email@example.com
# SMTP_SENDER_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# =============================================================================
# Search Configuration
# =============================================================================
SEARCH_KEYWORDS=software engineer
SEARCH_LOCATIONS=Remote,New York
MAX_RESULTS_PER_SEARCH=50

# Scoring thresholds
MIN_DISPLAY_SCORE=60
TOP_JOBS_LIMIT=20

# =============================================================================
# Job Sources
# =============================================================================
# Available: linkedin, web_scraping
ENABLED_SOURCES=web_scraping

# Web scraping platforms
WEB_SCRAPING_PLATFORMS=greenhouse,lever,bamboohr,ashby
SCRAPING_DELAY_SECONDS=2.0

# Discovery providers: jobspy, google_search, brave_search, serpapi
ENABLED_DISCOVERY_PROVIDERS=jobspy

# JobSpy settings
JOBSPY_SITES=indeed,glassdoor
JOBSPY_HOURS_OLD=24

# =============================================================================
# Location Filtering
# =============================================================================
# Comma-separated list of location terms to search/filter
LOCATION_TERMS=NY,New York,Remote,NYC

# =============================================================================
# Search Mode (for Google/Brave Search)
# =============================================================================
# Options: default, mid_level, exclude_senior, combined
SEARCH_MODE=combined

# Level terms to target (comma-separated)
LEVEL_TERMS=Software Engineer II,Software Engineer 2,SWE II,SWE 2

# Seniority levels to exclude (comma-separated)
# EXCLUDE_LEVELS=Senior,Staff,Principal,Lead

# =============================================================================
# Database & Logging
# =============================================================================
DATABASE_PATH=./data/jobs.db
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log
